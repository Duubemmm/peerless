======CMD======
cd /opt/peerless
NEW_SHA=4740dde46112ce000c0463ba389443114066500b

# Save current running SHA before touching anything, for rollback
CURRENT_SHA=$(grep -oP '(?<=peerless:)[a-f0-9]+' compose.yml || echo "none")
echo "$CURRENT_SHA" > PREVIOUS_VERSION

# Deploy new version
sed -i "s|image: ghcr.io/duubemmm/peerless:.*|image: ghcr.io/duubemmm/peerless:${NEW_SHA}|" compose.yml
docker compose pull
docker compose up -d
sleep 5

if curl -f http://localhost:3000/ready; then
  echo "Deployment successful: ${NEW_SHA}"
  echo "$NEW_SHA" > CURRENT_VERSION
else
  echo "Health check failed. Rolling back to ${CURRENT_SHA}"
  sed -i "s|image: ghcr.io/duubemmm/peerless:.*|image: ghcr.io/duubemmm/peerless:${CURRENT_SHA}|" compose.yml
  docker compose pull
  docker compose up -d
  sleep 5
  if curl -f http://localhost:3000/ready; then
    echo "Rollback successful: restored ${CURRENT_SHA}"
  else
    echo "Rollback also failed. Manual intervention required."
    exit 1
  fi
  exit 1
fi
